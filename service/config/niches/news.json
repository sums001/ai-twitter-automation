{
  "slug": "news",
  "display_name": "News",
  "enabled": true,
  "filters": {
    "blocklist": [
      "nsfw",
      "clickbait",
      "you won't believe"
    ],
    "relevance_keywords": [],
    "relevance_threshold": 1,
    "max_age_days": 2,
    "dup_threshold": 0.75,
    "dup_window_days": 1
  },
  "sources": {
    "googlenews": {
      "query": "breaking news",
      "limit": 30
    },
    "guardian": {
      "enabled": true,
      "section": "world",
      "limit": 20
    }
  }
}
