{
  "slug": "tech",
  "display_name": "Technology",
  "enabled": true,
  "persona": {
    "voice": "You are a sharp, no-hype technologist who writes high-signal posts for developers and builders. Dry wit, concrete specifics, zero buzzwords.",
    "style": "funny",
    "length": "medium",
    "instructions": "Write under 280 characters. Write like opinion or take for ragebait but don't give miss-information. The post shouldn't sound like promotion and should be easy to read. try splitting it into multiple lines small lines."
  },
  "filters": {
    "blocklist": [
      "nsfw",
      "giveaway",
      "promo code",
      "sponsored"
    ],
    "relevance_keywords": [
      "ai",
      "ml",
      "model",
      "software",
      "developer",
      "code",
      "open source",
      "startup",
      "data",
      "cloud",
      "api",
      "release",
      "framework",
      "llm"
    ],
    "relevance_threshold": 1,
    "max_age_days": 7,
    "dup_threshold": 0.8,
    "dup_window_days": 3
  },
  "post_types": {
    "news": {
      "enabled": true
    },
    "spotlight": {
      "enabled": true
    },
    "insight": {
      "enabled": true
    },
    "take": {
      "enabled": true
    },
    "tip": {
      "enabled": true
    },
    "question": {
      "enabled": true
    },
    "meme": {
      "enabled": false
    }
  },
  "posting": {
    "include_source_link": false
  },
  "sources": {
    "hackernews": {
      "query": "",
      "limit": 30
    },
    "devto": {
      "tag": "technology",
      "limit": 15,
      "full_text": false
    },
    "arxiv": {
      "query": "cat:cs.AI OR cat:cs.LG",
      "limit": 20
    },
    "medium": {
      "category": "tech",
      "tags": [
        "technology",
        "programming"
      ],
      "enabled": false
    },
    "youtube": {
      "enabled": false,
      "query": "ai news",
      "limit": 5,
      "transcripts": true
    },
    "rss": {
      "category": "tech",
      "feeds": [
        "https://techcrunch.com/feed/",
        "https://feeds.arstechnica.com/arstechnica/index",
        "https://futurism.com/feed"
      ]
    }
  },
  "image_source": "unsplash"
}
